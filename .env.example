# --- Vikunja ---
VIKUNJA_API_BASE=https://vikunja.yourdomain.com/api/v1
VIKUNJA_USERNAME=your_user
VIKUNJA_PASSWORD=your_pass
# If your cert is self-signed set to "false"
VIKUNJA_VERIFY_SSL=true

# Comma-separated; leave empty for ALL accessible projects, e.g. "2,5,9"
PROJECT_IDS=

# --- Google Calendar ---
GOOGLE_CALENDAR_NAME=Vikunja Tasks
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Comma-separated minutes before event. 1w, 3d, 2d, 1d, same day(0)
REMINDER_MINUTES=10080,4320,2880,1440,0

# --- Outputs (paths can be relative or absolute) ---
STATE_FILE=.state/state.json
ICS_OUTPUT=.out/vikunja_calendar.ics

# --- Optional ---
TIMEZONE=Europe/Madrid
